[Unit]
Description=Zekt Liquidation Zone Capture Service
Documentation=https://github.com/zekt/zekt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/kt/zekt/scripts/liquidation-capture.py --cycles 999999 --interval-secs 30 --output-dir /home/kt/zekt/data/liquidation-zones --wallets-file /home/kt/zekt/data/watchlist.json
WorkingDirectory=/home/kt/zekt
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zekt-liquidation-capture

# Environment
Environment=PYTHONUNBUFFERED=1

# Resource limits
MemoryMax=512M
CPUQuota=5%

[Install]
WantedBy=default.target
